{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "azhimov/payments-outbox",
    "type": "project",
    "description": "Demo payments service: laravel-idempotency + laravel-outbox under retries, relay crashes and broker restarts.",
    "keywords": [
        "laravel",
        "payments",
        "outbox",
        "idempotency",
        "demo"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "azhimov/laravel-idempotency": "^0.1",
        "azhimov/laravel-outbox": "^0.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "php-amqplib/php-amqplib": "^3.7",
        "predis/predis": "^2.2",
        "promphp/prometheus_client_php": "^2.14"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tools\\PhpStan\\": "tools/phpstan/"
        },
        "classmap": [
            "tests/Architecture/data"
        ]
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

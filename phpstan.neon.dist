includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - tools

rules:
    # App\Domain stays plain PHP: no Laravel, no Carbon, no outer layers.
    - Tools\PhpStan\DomainIsolationRule
